# PhishLens Environment Configuration

# Google AI Studio API Key (Server-Side Only - Never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Selected Gemma 4 Multimodal Model
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional Request Timeout (in milliseconds)
GEMINI_TIMEOUT_MS=60000

# Legacy / Alternative Local Ollama Configuration (Optional)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CONNECT_TIMEOUT_MS=10000
# OLLAMA_INFERENCE_TIMEOUT_MS=240000
